<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SpringOnion.ViewModels"
             x:Class="SpringOnion.Views.Dashboard"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout Padding="20" Spacing="15">

        <HorizontalStackLayout Spacing="10">
            <Button Text="Refresh" 
                    Command="{Binding RefreshConversationsCommand}" />
            <Button Text="Send Test Message" 
                    Command="{Binding CreateTestConversationCommand}" />
        </HorizontalStackLayout>

        <Label Text="Conversations:"
               FontAttributes="Bold"
               FontSize="16" />

        <CollectionView ItemsSource="{Binding Conversations}"
                        HeightRequest="250">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5"
                           BorderColor="LightGray" 
                           CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding ConversationId}" 
                                   FontAttributes="Bold" 
                                   FontSize="14"/>
                            <Label Text="{Binding Type}" FontSize="12" />
                            <Label Text="{Binding LastActivityUtc}" 
                                   FontSize="12" 
                                   TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="{Binding StatusMessage}" 
               FontSize="14"
               TextColor="DarkGreen"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
